
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebHtmlBox.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1600
    Set psCaption to "FutbolWebApp"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"

    Object oWebMainPanel is a cWebPanel

        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 1

        Object oTiles_grp is a cWebGroup

            Set piColumnSpan to 12
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            WebSetResponsive piColumnSpan rmMobile to 1
            WebSetResponsive piColumnCount rmMobile to 6

            // ==================================
            // TARJETA 1 - LIGAS
            // ==================================

            
            
        Object oTileLigas is a cWebHtmlBox

            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set psCSSClass to "Tile Light"
            Set pbServerOnClick to True

            Set psHtml to ('<div class="WebCon_Sizer" ' + ;
                'data-ServerOnClick="liga" ' + ;
                'data-OnClickParam="openview">' + ;
                '<div class="Tile_Title">Ligas</div>' + ;
                '<div class="Tile_Subtitle">Gestion de competiciones</div>' + ;
                '</div>')

            WebRegisterPath ntNavigateForwardCustom oSelectLiga

            Procedure OnClick String sId String sParam
                Send NavigatePath
            End_Procedure

        End_Object

            // ==================================
            // TARJETA 2 - EQUIPOS
            // ==================================

            Object oTileEquipos is a cWebHtmlBox

                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"
                Set pbServerOnClick to True

                Set psHtml to ('<div class="WebCon_Sizer" ' + ;
                'data-ServerOnClick="equipo" ' + ;
                'data-OnClickParam="openview">' + ;
                '<div class="Tile_Title">Equipos</div>' + ;
                '<div class="Tile_Subtitle">Gestion de equipos</div>' + ;
                '</div>')
                
                WebRegisterPath ntNavigateForwardCustom oSelectEquipo

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure

            End_Object

            // ==================================
            // TARJETA 3 - JUGADORES
            // ==================================

            Object oTileJugadores is a cWebHtmlBox

                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set psCSSClass to "Tile Dark"

                Set psHtml to ('<div class="WebCon_Sizer">' + ;
                    '<div class="Tile_Title">Jugadores</div>' + ;
                    '<div class="Tile_Subtitle">' + ;
                    'Plantillas y jugadores' + ;
                    '</div></div>')

            End_Object

            // ==================================
            // TARJETA 4 - ENTRENADORES
            // ==================================

            Object oTileEntrenadores is a cWebHtmlBox

                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile DarkAlternate"

                Set psHtml to ('<div class="WebCon_Sizer">' + ;
                    '<div class="Tile_Title">Entrenadores</div>' + ;
                    '<div class="Tile_Subtitle">' + ;
                    'Gestion de tecnicos' + ;
                    '</div></div>')

            End_Object

            // ==================================
            // TARJETA 5 - POSICIONES
            // ==================================

            Object oTilePosiciones is a cWebHtmlBox

                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set psCSSClass to "Tile Light"
                Set pbServerOnClick to True

                Set psHtml to ('<div class="WebCon_Sizer" ' + ;
                'data-ServerOnClick="posiciones" ' + ;
                'data-OnClickParam="openview">' + ;
                '<div class="Tile_Title">Posiciones</div>' + ;
                '<div class="Tile_Subtitle">Gestion de posiciones</div>' + ;
                '</div>')
                    
                WebRegisterPath ntNavigateForwardCustom oSelectPosicion

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure

            End_Object

            // ==================================
            // TARJETA 6 - JUGADOR POSICION
            // ==================================

            Object oTileJugadorPosicion is a cWebHtmlBox

                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"

                Set psHtml to ('<div class="WebCon_Sizer">' + ;
                    '<div class="Tile_Title">Jugador - Posicion</div>' + ;
                    '<div class="Tile_Subtitle">' + ;
                    'Asignacion de posiciones' + ;
                    '</div></div>')

            End_Object

        End_Object

    End_Object

    Procedure OnBeforeShow
        Forward Send OnBeforeShow
    End_Procedure

End_Object
